{
  "version": 4,
  "events": {
    "app_open": { "cold": "bool" },
    "onboarding_step": { "step": "string", "index": "int" },
    "onboarding_done": {},
    "first_log": { "kind": ["enum", "glucose", "meal", "other"] },
    "log_added": { "kind": ["enum", "glucose", "meal", "other"] },
    "log_edited": { "kind": ["enum", "glucose", "meal", "other"] },
    "paywall_view": { "source": "string", "context": "string", "trial_eligible": "bool", "variant": ["enum", "default"] },
    "paywall_tier_selected": { "tier": ["enum", "monthly", "annual", "lifetime"] },
    "paywall_cta": { "tier": ["enum", "monthly", "annual", "lifetime"] },
    "paywall_dismiss": { "source": "string" },
    "purchase_completed": { "tier": "string", "source": "string" },
    "purchase_result": {
      "result": ["enum", "success", "cancelled", "error"],
      "product": ["enum", "monthly", "annual", "lifetime", "downsell_annual"],
      "reason": ["enum", "after_logs", "direct", "health", "foods", "profiles", "feature", "mealResponse", "spike", "insights", "export", "settings"],
      "variant": ["enum", "default"],
      "trial": "bool",
      "detail": ["enum", "store_error", "already_owned", "none"]
    },
    "trial_started": { "tier": "string" },
    "pro_welcome_view": {},
    "pro_welcome_step": { "step": ["enum", "health", "insights", "reminders"], "done": "bool" },
    "health_connected": { "platform": ["enum", "ios", "android"], "imported": "int" },
    "insights_view": { "range_days": "int", "during_trial": "bool" },
    "export_pdf": { "during_trial": "bool" },
    "trial_reminder_scheduled": { "days_before": "int" },
    "trial_reminder_opened": {},
    "trial_day1_nudge_sent": {},
    "entitlement_lost": { "period_type": ["enum", "trial", "normal", "intro", "unknown"] },
    "winback_view": {},
    "downsell_view": { "trigger": "string" },
    "downsell_accept": { "trigger": "string" },
    "downsell_dismiss": { "trigger": "string" },
    "downsell_skipped_no_discount": {},
    "spike_opened": {},
    "spike_message_sent": { "has_context": "bool", "tier": ["enum", "free", "pro"] },
    "spike_reply": { "latency_ms": "int", "filtered": "bool", "actions": "int", "streamed": "bool" },
    "spike_feedback": { "value": ["enum", "up", "down"] },
    "spike_action_tap": { "action": "string" },
    "spike_context_consent": { "granted": "bool" },
    "carb_estimate_used": { "tier": ["enum", "free", "pro"], "item_count": "int", "source": ["enum", "food_tab", "meal_sheet"] },
    "carb_estimate_blocked": { "reason": ["enum", "quota", "filtered", "error"] },
    "analytics_opt_out": { "enabled": "bool" },
    "store_review_prompt": { "trigger": ["enum", "log_saved", "streak_7", "weekly_insights_view", "pdf_export_success"] },
    "feedback_sent": {
      "kind": ["enum", "suggestion", "bug", "other", "cancel_survey"],
      "reason_code": ["enum", "expensive", "not_used", "missing_feature", "bug", "other_app", "other", "none"]
    }
