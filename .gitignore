# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (CNG: regenerated by prebuild)
/ios
/android

# Local Expo modules: the Kotlin/Swift sources under modules/*/android are
# tracked, but their Gradle build output is not. /android above only covers the
# app's own generated project, not these.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# Raw store-screenshot captures (composited into zerospike-store/; not tracked)
/raw

# Store listing assets (ASO copy + composited screenshots; local only)
/zerospike-store

# NOTE: /wear IS tracked. It is a standalone Gradle project for the Wear OS
# companion, built and uploaded separately from the phone AAB, and it carries
# its own .gitignore for build output. Do not add it here.

# Build outputs & secrets
*.ipa
*.aab
*.apk
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
keystore.properties
google-services.json
GoogleService-Info.plist
.env*.local
.env

# Metro
.metro-health-check*

# Standalone test-harness build output (scripts/*.test.ts → .tmp)
.tmp*

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Python bytecode
__pycache__/

# Apple Ads API kimlikleri, repo disinda ~/.apple-ads/ altinda tutulur
credentials.txt
*.pem
scratchpad/metrics/
scratchpad/**/.asc-raw
