<?xml version="1.0" encoding="utf-8"?>
<!-- Same launcher background the phone app uses (android/app/src/main/res/values/colors.xml,
     generated by Expo from app.json adaptiveIcon.backgroundColor). -->
<resources>
    <color name="iconBackground">#000000</color>
    <!-- THEME.bg.g1 in lib/theme/tokens.ts: the Midnight Monitor ground every
         zerospike surface sits on. Used as the window background so launching
         the app does not flash platform black before Compose draws. -->
    <color name="ground">#FF080E14</color>
</resources>
