<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zerospike" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
    </style>

    <!-- Play WO-V15: black background, launcher icon at startup. -->
    <style name="Theme.Zerospike.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Zerospike</item>
    </style>
</resources>
