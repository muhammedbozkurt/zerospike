{
  "expo": {
    "name": "zerospike",
    "slug": "zerospike",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zerospike",
    "userInterfaceStyle": "dark",
    "locales": {
      "tr": "./ios-locales/tr.json",
      "de": "./ios-locales/de.json",
      "fr": "./ios-locales/fr.json",
      "es": "./ios-locales/es.json",
      "it": "./ios-locales/it.json",
      "pt": "./ios-locales/pt.json",
      "ar": "./ios-locales/ar.json",
      "ja": "./ios-locales/ja.json"
    },
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greeneyeapp.zerospike",
      "appleTeamId": "YWRPV58T86",
      "buildNumber": "58",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "zerospike uses your camera to scan food barcodes and add meal photos.",
        "NSPhotoLibraryUsageDescription": "zerospike accesses your photo library to add photos to your meal journal.",
        "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries.",
        "NSHealthUpdateUsageDescription": "zerospike writes the blood glucose readings you enter by hand to Apple Health, only when you turn this on in Settings.",
        "NSLocationWhenInUseUsageDescription": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
        "NSContactsUsageDescription": "zerospike lets you pick an emergency contact from your contacts for the SOS screen.",
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "ar",
          "ja"
        ],
        "NSSupportsLiveActivities": true,
        "NSMotionUsageDescription": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.greeneyeapp.zerospike"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.greeneyeapp.zerospike",
      "versionCode": 55,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidNavBarContrast",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "zerospike uses your camera to scan food barcodes and add meal photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zerospike accesses your photo library to add photos to your meal journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22d3ee",
          "sounds": [
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries.",
          "NSHealthUpdateUsageDescription": "zerospike writes the blood glucose readings you enter by hand to Apple Health, only when you turn this on in Settings.",
          "background": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "zerospike lets you pick an emergency contact from your contacts for the SOS screen."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Zerospike",
              "label": "zerospike",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "zerospike",
              "previewImage": "./assets/icon.png",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 900000
            },
            {
              "name": "ZerospikeQuickAdd",
              "label": "zerospike +",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "description": "zerospike",
              "previewImage": "./assets/icon.png",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#04161d"
        }
      ],
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c52316bd-99ee-4ae9-8254-2a3542585ffb"
      },
      "spikeFnUrl": "https://zobtmenqgsradocrxdtc.supabase.co/functions/v1/ai-ask-spike"
    }
  }
}
