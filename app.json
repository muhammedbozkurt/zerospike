    "android": {
      "package": "com.greeneyeapp.zerospike",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.greeneyeapp.zerospike",
      "versionCode": 96,
      "allowBackup": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/brand/adaptive-background-1024.png",
        "monochromeImage": "./assets/brand/monochrome-1024.png",
        "backgroundColor": "#0f92bd"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_PROMOTED_NOTIFICATIONS",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.WRITE_BLOOD_GLUCOSE",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ],
      "blockedPermissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidNavBarContrast",
      "./plugins/withAndroidPermissionTrim",
      "./plugins/withAndroidProguardRules",
      "./plugins/withGradleHeap",
      "./plugins/withHealthRationaleRouting",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": [
              "en",
              "tr",
              "de",
              "fr",
              "es",
              "it",
              "pt",
              "ar",
              "ja",
              "en-GB",
              "en-AU",
              "en-CA"
            ]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "zerospike uses your camera to scan food barcodes and add meal photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zerospike accesses your photo library to add photos to your meal journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon-96.png",
          "color": "#26d9ea",
          "sounds": [
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries. It can also import new glucose readings in the background when the system allows it.",
          "NSHealthUpdateUsageDescription": "zerospike writes to Apple Health only when you allow it: in Settings, when connecting Apple Health, or when asked after saving an entry. This covers the blood glucose readings you enter by hand and, if you turn them on, the carbohydrate and insulin entries you log. Nothing else is written, and an entry you delete in zerospike is deleted from Apple Health too.",
          "background": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "zerospike lets you pick an emergency contact from your contacts for the SOS screen."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withHealthBackgroundDelivery",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Zerospike",
              "label": "zerospike",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "zerospike",
              "previewImage": "./assets/widget-previews/Zerospike.png",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
