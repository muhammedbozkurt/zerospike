{
  "expo": {
    "name": "zerospike",
    "slug": "zerospike",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "scheme": "zerospike",
    "userInterfaceStyle": "automatic",
    "locales": {
      "tr": "./ios-locales/tr.json",
      "de": "./ios-locales/de.json",
      "fr": "./ios-locales/fr.json",
      "es": "./ios-locales/es.json",
      "it": "./ios-locales/it.json",
      "pt": "./ios-locales/pt.json",
      "ar": "./ios-locales/ar.json",
      "ja": "./ios-locales/ja.json"
    },
    "backgroundColor": "#000000",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greeneyeapp.zerospike",
      "appStoreUrl": "https://apps.apple.com/app/id6778782351",
      "appleTeamId": "YWRPV58T86",
      "buildNumber": "80",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "zerospike",
        "NSCameraUsageDescription": "zerospike uses your camera to scan food barcodes and add meal photos.",
        "NSPhotoLibraryUsageDescription": "zerospike accesses your photo library to add photos to your meal journal.",
        "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries.",
        "NSHealthUpdateUsageDescription": "zerospike writes the blood glucose readings you enter by hand to Apple Health, only when you allow it: in Settings, when connecting Apple Health, or when asked after saving a reading. Nothing else is written, and a reading you delete in zerospike is deleted from Apple Health too.",
        "NSLocationWhenInUseUsageDescription": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
        "NSContactsUsageDescription": "zerospike lets you pick an emergency contact from your contacts for the SOS screen.",
        "NSAlarmKitUsageDescription": "zerospike uses AlarmKit so the reminders you set up, and the post-meal countdown you start, can ring as real alarms. You can switch any of them back to a notification.",
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "ar",
          "ja"
        ],
        "NSSupportsLiveActivities": true,
        "NSMotionUsageDescription": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.greeneyeapp.zerospike"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeHealth",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics",
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeProductPersonalization"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAdvertisingData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeDeveloperAdvertising",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics",
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics",
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePerformanceData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAnalytics",
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDiagnosticData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.greeneyeapp.zerospike",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.greeneyeapp.zerospike",
      "versionCode": 80,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-1024.png",
        "backgroundImage": "./assets/brand/adaptive-background-1024.png",
        "monochromeImage": "./assets/brand/monochrome-1024.png",
        "backgroundColor": "#0f92bd"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_PROMOTED_NOTIFICATIONS",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.WRITE_BLOOD_GLUCOSE"
      ],
      "blockedPermissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidNavBarContrast",
      "./plugins/withAndroidPermissionTrim",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "zerospike uses your camera to scan food barcodes and add meal photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zerospike accesses your photo library to add photos to your meal journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon-96.png",
          "color": "#26d9ea",
          "sounds": [
            "./assets/sounds/reminder.wav"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries.",
          "NSHealthUpdateUsageDescription": "zerospike writes the blood glucose readings you enter by hand to Apple Health, only when you allow it: in Settings, when connecting Apple Health, or when asked after saving a reading. Nothing else is written, and a reading you delete in zerospike is deleted from Apple Health too.",
          "background": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "zerospike lets you pick an emergency contact from your contacts for the SOS screen."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withSceneLifecycle",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Zerospike",
              "label": "zerospike",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ZerospikeReading",
              "label": "zerospike",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ZerospikeQuickAdd",
              "label": "zerospike +",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            },
            {
              "name": "ZerospikeLogGlucose",
              "label": "zerospike +",
              "minWidth": "80dp",
              "minHeight": "80dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ZerospikeLogMeal",
              "label": "zerospike +",
              "minWidth": "80dp",
              "minHeight": "80dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ZerospikeTimer",
              "label": "zerospike",
              "minWidth": "80dp",
              "minHeight": "80dp",
              "description": "zerospike",
              "previewImage": "./assets/brand/icon-1024.png",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-glyph-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6",
          "dark": {
            "image": "./assets/brand/splash-glyph.png",
            "backgroundColor": "#04161d"
          }
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c52316bd-99ee-4ae9-8254-2a3542585ffb"
      },
      "spikeFnUrl": "https://jcpepqectdubbmchhdsn.supabase.co/functions/v1/ai-ask-spike",
      "trackFnUrl": "https://jcpepqectdubbmchhdsn.supabase.co/functions/v1/track",
      "deleteDeviceFnUrl": "https://jcpepqectdubbmchhdsn.supabase.co/functions/v1/delete-device"
    }
  }
}
