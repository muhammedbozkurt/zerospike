{
  "expo": {
    "name": "zerospike",
    "slug": "zerospike",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zerospike",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#04161d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greeneyeapp.zerospike",
      "buildNumber": "16",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "zerospike uses your camera to scan food barcodes and add meal photos.",
        "NSPhotoLibraryUsageDescription": "zerospike accesses your photo library to add photos to your meal journal.",
        "NSHealthShareUsageDescription": "zerospike reads your blood glucose readings from Apple Health to log them automatically."
      }
    },
    "android": {
      "package": "com.greeneyeapp.zerospike",
      "versionCode": 16,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_BLOOD_GLUCOSE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "zerospike uses your camera to scan food barcodes and add meal photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zerospike accesses your photo library to add photos to your meal journal."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22d3ee"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "zerospike reads your blood glucose readings from Apple Health to log them automatically.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "zerospike lets you pick an emergency contact from your contacts for the SOS screen."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c52316bd-99ee-4ae9-8254-2a3542585ffb"
      }
    }
  }
}
