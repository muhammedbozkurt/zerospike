      "bundleIdentifier": "com.greeneyeapp.zerospike",
      "appStoreUrl": "https://apps.apple.com/app/id6778782351",
      "appleTeamId": "YWRPV58T86",
      "buildNumber": "96",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "zerospike",
        "NSCameraUsageDescription": "zerospike uses your camera to scan food barcodes and add meal photos.",
        "NSPhotoLibraryUsageDescription": "zerospike accesses your photo library to add photos to your meal journal.",
        "NSHealthShareUsageDescription": "zerospike reads your blood glucose, insulin delivery and active-minute data from Apple Health to show them in your log and summaries. It can also import new glucose readings in the background when the system allows it.",
        "NSHealthUpdateUsageDescription": "zerospike writes to Apple Health only when you allow it: in Settings, when connecting Apple Health, or when asked after saving an entry. This covers the blood glucose readings you enter by hand and, if you turn them on, the carbohydrate and insulin entries you log. Nothing else is written, and an entry you delete in zerospike is deleted from Apple Health too.",
        "NSLocationWhenInUseUsageDescription": "zerospike can attach your current location to a message you send from the SOS screen, so someone can find you faster.",
        "NSContactsUsageDescription": "zerospike lets you pick an emergency contact from your contacts for the SOS screen.",
        "NSAlarmKitUsageDescription": "zerospike uses AlarmKit so the reminders you set up, and the post-meal countdown you start, can ring as real alarms. You can switch any of them back to a notification.",
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "fr",
          "es",
          "it",
          "pt",
          "ar",
          "ja",
          "en-GB",
          "en-AU",
          "en-CA"
        ],
        "NSSupportsLiveActivities": true,
        "NSMotionUsageDescription": "zerospike does not collect motion data. A location component in the app references this permission; your movement is never tracked."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.greeneyeapp.zerospike"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
