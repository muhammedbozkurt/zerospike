require "json"

def zs_require_env(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} tanimli degil: ilgili anahtar dosyasinin yolunu ortam degiskenine ver.") if value.empty?
  value
end

def zs_app_version
  JSON.parse(File.read(File.expand_path("../app.json", __dir__))).fetch("expo").fetch("version")
end

def zs_asc_api_key
  path = zs_require_env("ZS_ASC_KEY_JSON")
  UI.user_error!("ZS_ASC_KEY_JSON gosterdigi dosya yok.") unless File.file?(path)
  cfg = JSON.parse(File.read(path))
  %w[key_id issuer_id key_filepath].each do |k|
    UI.user_error!("ZS_ASC_KEY_JSON icinde #{k} eksik.") if cfg[k].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: cfg["key_id"],
    issuer_id: cfg["issuer_id"],
    key_filepath: cfg["key_filepath"],
    is_key_content_base64: false,
    in_house: false
  )
end

def zs_deliver(force:)
  deliver(
    api_key: zs_asc_api_key,
    app_version: zs_app_version,
    skip_binary_upload: true,
    force: force,
    skip_screenshots: false,
    skip_metadata: false,
    submit_for_review: false,
    automatic_release: false,
    precheck_include_in_app_purchases: false
  )
end

def zs_supply(validate_only:)
  path = zs_require_env("ZS_PLAY_JSON_KEY")
  UI.user_error!("ZS_PLAY_JSON_KEY gosterdigi dosya yok.") unless File.file?(path)
  supply(
    json_key: path,
    package_name: "com.greeneyeapp.zerospike",
    track: "production",
    skip_upload_changelogs: true,
    metadata_path: "fastlane/metadata/android",
    skip_upload_apk: true,
    skip_upload_aab: true,
    validate_only: validate_only
  )
end

platform :ios do
  desc "Metin ve gorsel onizleme (HTML), yukleme yok"
  lane :metadata_check do
    zs_deliver(force: false)
  end

  desc "Metin ve gorselleri yukler; binary ve review yok"
  lane :metadata_upload do
    zs_deliver(force: true)
  end
end

platform :android do
  desc "Play metadata dogrulama, yukleme yok"
  lane :validate do
    zs_supply(validate_only: true)
  end

  desc "Play metadata yukleme; binary yok"
  lane :upload do
    zs_supply(validate_only: false)
  end
end
