# .easignore — files excluded from the EAS Build upload tarball.
# EAS runs `expo prebuild` and `npm install` on its servers, so native
# folders and local dependencies must NOT be uploaded.
#
# IMPORTANT: patches/ is intentionally NOT ignored — the postinstall
# patch-package step needs it to fix expo-localization (and any Android
# Kotlin patches) during the EAS install phase.

# Native projects — regenerated by EAS prebuild (CNG)
/ios
/android

# Dependencies & build caches — reinstalled / rebuilt by EAS
node_modules/
.expo/
dist/
web-build/
.metro-health-check*
expo-env.d.ts

# Local build outputs & store artifacts
*.ipa
*.aab
*.apk

# Signing material & secrets (handled by EAS credentials, never upload)
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
.env
.env*.local

# Firebase config: kept out of git (.gitignore) but MUST reach EAS Build, since
# the config plugin copies googleServicesFile during prebuild. Intentionally
# NOT listed here (client-side config, not a secret).

# VCS / editor / OS noise
.git
.gitignore
.idea/
.vscode/
.DS_Store

# Docs (not needed inside the build)
README.md

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Store visuals & planning docs — never part of the app binary, keep the upload small
zerospike-store*/
/raw
docs/
HUMAN-TODO.md
.tmp*
